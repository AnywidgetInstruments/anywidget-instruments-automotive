{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anywidgetinstruments.github.io/anywidget-instruments-automotive/schema/temperaturegauge.schema.json",
  "title": "TemperatureGauge",
  "description": "Coolant or oil temperature, with cold and hot zones; the temperature tell-tale is lit red in the hot zone (DIAL-107, DIAL-108).",
  "type": "object",
  "x-awi-class": "TemperatureGauge",
  "x-awa-quantity": "temperature",
  "allOf": [
    {
      "$ref": "dial.schema.json"
    }
  ],
  "properties": {
    "_kind": {
      "const": "awa-temperaturegauge",
      "default": "awa-temperaturegauge",
      "x-awi-writer": "host"
    },
    "unit": {
      "$ref": "units.schema.json#/$defs/temperature"
    },
    "input_unit": {
      "$ref": "units.schema.json#/$defs/temperature"
    },
    "min": {
      "default": 40
    },
    "max": {
      "default": 130
    },
    "cold": {
      "$ref": "https://anywidgetinstruments.github.io/anywidget-instruments/schema/instrument.schema.json#/$defs/optionalNumber",
      "description": "Upper end of the cold zone, in input_unit; null: none.",
      "default": 60,
      "x-awi-writer": "host"
    },
    "hot": {
      "$ref": "https://anywidgetinstruments.github.io/anywidget-instruments/schema/instrument.schema.json#/$defs/optionalNumber",
      "description": "Start of the hot zone, in input_unit, where the temperature tell-tale lights (DIAL-108); null: none.",
      "default": 115,
      "x-awi-writer": "host"
    },
    "ticks": {
      "default": 3
    },
    "size": {
      "default": [
        160,
        130
      ]
    },
    "label": {
      "default": "Coolant"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s-celles.github.io/anywidget-automotives/schema/gearindicator.schema.json",
  "title": "GearIndicator",
  "description": "The engaged gear, and an up or down shift suggestion (DIG-006, DIG-007).",
  "type": "object",
  "x-awi-class": "GearIndicator",
  "allOf": [
    {
      "$ref": "automotive.schema.json"
    }
  ],
  "properties": {
    "_kind": {
      "const": "awa-gearindicator",
      "default": "awa-gearindicator",
      "x-awi-writer": "host"
    },
    "value": {
      "enum": [
        "P",
        "R",
        "N",
        "D",
        "1",
        "2",
        "3",
        "4",
        "5",
        "6",
        "7",
        "8",
        null
      ],
      "description": "Engaged gear: P, R, N, D or a gear number; null: not known (ROB-002).",
      "default": null,
      "x-awi-writer": "host"
    },
    "suggestion": {
      "enum": [
        "",
        "up",
        "down"
      ],
      "description": "Shift suggestion shown as an arrow; empty: none (DIG-007).",
      "default": "",
      "x-awi-writer": "host"
    },
    "label": {
      "default": "Gear"
    },
    "size": {
      "default": [
        90,
        110
      ]
    }
  }
}

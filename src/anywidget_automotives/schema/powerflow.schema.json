{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s-celles.github.io/anywidget-automotives/schema/powerflow.schema.json",
  "title": "PowerFlow",
  "description": "Which of the engine, the battery and the wheels deliver and receive power in a hybrid drivetrain, by arrows and in text (EV-007).",
  "type": "object",
  "x-awi-class": "PowerFlow",
  "allOf": [
    {
      "$ref": "automotive.schema.json"
    }
  ],
  "properties": {
    "_kind": {
      "const": "awa-powerflow",
      "default": "awa-powerflow",
      "x-awi-writer": "host"
    },
    "value": {
      "type": [
        "object",
        "null"
      ],
      "description": "Power in kW: engine (≥ 0, delivered by the engine), battery (> 0 discharging, < 0 charging), wheels (> 0 driven, < 0 braking with regeneration). null: not known (ROB-002).",
      "properties": {
        "engine": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "battery": {
          "type": [
            "number",
            "null"
          ]
        },
        "wheels": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "default": null,
      "x-awi-writer": "host"
    },
    "label": {
      "default": "Power flow"
    },
    "size": {
      "default": [
        240,
        150
      ]
    }
  }
}
